@startuml VitaStore-TO-BE-C4-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title VitaStore - Целевая архитектура (TO-BE, C4 Container)

' ==========================================================
'  ЛЮДИ
' ==========================================================
Person(customer, "Покупатель", "Оплачивает наличными/картой, копит/списывает баллы")
Person(cashier, "Кассир", "Пробивает чеки на тонком клиенте")
Person(dataSteward, "Товаровед / Data Integration", "Подтверждает спорные позиции маппинга и правит позиции с ошибками контроля качества")
Person(fieldEng, "Выездной ИТ-инженер", "Ставит планшет и оборудование новой точки, загружает дамп номенклатуры, регистрирует оборудование в реестре")
Person(storeOps, "Инженер Team Store Ops (HQ)", "Ведёт реестр точек и оборудования, поддерживает каталог драйвер-адаптеров и конфигурацию")

' ==========================================================
'  ВНЕШНИЕ СИСТЕМЫ
' ==========================================================
System_Ext(acquirer, "Банки-эквайеры / платёжные системы", "Авторизация карточных платежей (Сбербанк, Альфа-Банк и др.)")
System_Ext(ofd, "ОФД -> ФНС", "Приём фискальных документов, в т.ч. отложенно после офлайна")
System_Ext(legacyPos, "Легаси-касса купленного магазина", "Источник дампа номенклатуры")

' ==========================================================
'  МАГАЗИН (STORE EDGE) - только планшет и оборудование, без локального сервера
' ==========================================================
System_Boundary(store, "Магазин (Store Edge) - тонкий клиент, без локальных серверов (реплицируется на 500+ точек)") {

    Container(pos, "Cloud POS (тонкий клиент)", "Приложение на планшете", "UI кассы без бизнес-логики и без драйверов оборудования. Онлайн работает с облаком, при обрыве связи переключается на локальный API Store Edge Gateway")

    Container(edgeGw, "Store Edge Gateway (HAL / Payment Gateway)", "Локальный сервис на планшете (контейнер/edge-runtime)", "Единый API оплаты и фискализации независимо от модели устройства. Разные драйвер-адаптеры под вендоров: ARCUS-2/Сбер, Ingenico, Verifone, Альфа. Держит read-only кэш мастер-данных и outbox офлайн-событий для автономной работы до 24 ч")

    ContainerDb(edgeCache, "Локальный кэш + Outbox", "встроенная БД на планшете (SQLite)", "Read-only кэш: SKU, цены, снимок правил Promo, балансы/лимиты лояльности.\nOutbox: неизменяемые офлайн-события (чек, оплата, баллы, движение товара) с идемпотентным ключом")

    Container_Ext(fiscal, "Фискальный регистратор (ККТ)", "COM / USB, фискальный накопитель", "Печать фискальных чеков; ФН хранит документы локально и допускает отложенную передачу в ОФД")
    Container_Ext(terminal, "Банковский терминал", "USB / протокол вендора (ARCUS-2, Ingenico, Verifone, Альфа)", "Модель зависит от точки; подключается к своему банку-эквайеру")
}

' ==========================================================
'  ОБЛАКО VITASTORE (CLOUD BACKEND)
' ==========================================================
System_Boundary(cloud, "VitaStore Cloud Platform") {

    Container(apiGw, "API Gateway", "Managed API Gateway", "Единая точка входа из магазинов: аутентификация, mTLS, маршрутизация")

    Container(posBackend, "Cloud POS Backend", "SaaS Cloud POS", "Расчёт чека, каталог/цены для кассы, сессии продаж, возвраты. Источник каталога - Catalog read-model (наполняется из MDM/Pricing/Promo)")

    Container(syncSvc, "Sync / Ingest Service", "Cloud service (event ingest)", "Тонкий слой (только транспорт, без бизнес-логики): приём outbox-событий, дедупликация по идемпотентному ключу (at-least-once), приоритизация (фискальные/платёжные данные -> лояльность -> товародвижение -> аналитика). Транслирует события в те же доменные команды/API, что и онлайн-путь")

    Container(deviceReg, "Device and Config Registry", "Cloud service + config store", "Реестр точек и оборудования: какой адаптер/протокол терминала и ККТ у каждого магазина. Пушит конфигурацию адаптеров и обновления кэша на Store Edge Gateway")

    Container(loyalty, "Loyalty / CRM", "SaaS", "Программа лояльности: карты, балансы, начисление/списание баллов (вместо «тетрадки»)")

    Container(promo, "Promo Engine", "Cloud (in-house)", "Единый движок промоакций - конкурентное преимущество; отдаёт снимок правил в edge-кэш")

    Container(fulfillment, "Smart Fulfillment", "Cloud (in-house)", "Омниканальная логистика, Click & Collect - конкурентное преимущество")

    ' --- Данные по доменам (декомпозиция бывшего монолита SAP ERP: database-per-service, без общей БД) ---
    Container(mdm, "Master Data Service (MDM)", "Cloud service", "Владелец продуктовых мастер-данных. Единая точка правды для онбординга и маппинга; отдаёт данные другим сервисам через API")
    ContainerDb(mdmDb, "Product Master DB", "Managed DB", "Эталонная база SKU, товары, штрихкоды, атрибуты")
    Container(pricing, "Pricing Service", "Cloud service", "Управление ценами и прайс-листами; источник цен для каталога и промо")
    ContainerDb(pricingDb, "Pricing DB", "Managed DB", "Цены, прайс-листы, правила ценообразования")
    ContainerDb(catalogDb, "Catalog DB (read-model)", "Managed DB / read replica", "Сбытовой каталог для касс: товар + цена + снимок промо; реплицируется в edge-кэш")
    Container(salesSvc, "Sales / Ops Service", "Cloud service", "Владелец операционных транзакций: проведение продаж/возвратов, товародвижение, остатки. Единая логика записи для онлайн- и офлайн-пути")
    ContainerDb(salesDb, "Sales / Ops DB", "Managed DB", "Операционные транзакции: чеки, продажи, товародвижение, остатки")
    ContainerDb(sapCore, "SAP ERP Core (managed)", "PaaS, migrated", "Система записи финансов и кадров: бухгалтерия, налоговая отчётность, ЗП")

    ' --- Онбординг новой точки ---
    Container(diPortal, "Data Integration Portal", "Web app", "Приём, валидация и нормализация дампа номенклатуры (вместо email/Excel); оркестрация автомаппинга; автоматический контроль качества (дубли штрихкодов, аномалии цен/маржи); UI-очередь спорных позиций для товароведа; загрузка проверенной номенклатуры в MDM")
    Container(aiMap, "AI Mapping Service", "Cloud ML service", "Авто-сопоставление SKU с эталонной базой MDM: точное по штрихкоду + семантическое по названию; рассчитывает confidence-score по каждой позиции. >=95% - авто, <95% - в очередь товароведу")
}

' ==========================================================
'  СВЯЗИ: ПРОДАЖА (ОНЛАЙН)
' ==========================================================
Rel(customer, cashier, "Покупка, оплата, баллы", "лично")
Rel(cashier, pos, "Пробитие чеков, оплата, лояльность", "UI")
Rel(pos, apiGw, "Каталог/цены, расчёт чека, лояльность, промо, заказы Click & Collect (когда онлайн)", "HTTPS/REST")

' ==========================================================
'  СВЯЗИ: РАБОТА С ОБОРУДОВАНИЕМ ЧЕРЕЗ HAL
' ==========================================================
Rel(pos, edgeGw, "Единый API: оплатить / фискализировать / прочитать кэш", "localhost HTTPS")
Rel(edgeGw, terminal, "Инициация оплаты через адаптер конкретного вендора", "USB / протокол вендора")
Rel(edgeGw, fiscal, "Печать фискального чека", "COM / USB")
Rel(terminal, acquirer, "Авторизация карточного платежа", "защищённый канал банка")
Rel(fiscal, ofd, "Передача фискальных документов (в т.ч. отложенно)", "по каналу связи")

' ==========================================================
'  СВЯЗИ: ОФЛАЙН-РЕЖИМ И СИНХРОНИЗАЦИЯ
' ==========================================================
Rel(edgeGw, edgeCache, "Чтение кэша, запись офлайн-событий в outbox", "локально")
Rel_U(edgeGw, apiGw, "Синхронизация outbox при восстановлении связи + инкрементальные обновления кэша", "HTTPS, mTLS, at-least-once")
Rel(apiGw, syncSvc, "Маршрутизация событий синхронизации", "internal")
Rel(deviceReg, edgeGw, "Пуш конфигурации адаптеров и обновлений кэша", "HTTPS, mTLS")
Rel(storeOps, deviceReg, "Ведёт каталог адаптеров и конфигурацию точек", "Web UI")
Rel(fieldEng, deviceReg, "Регистрирует оборудование новой точки (модели терминала/ККТ)", "Web UI")

' ==========================================================
'  СВЯЗИ: ОБЛАЧНЫЙ БЭКЕНД
' ==========================================================
Rel(apiGw, posBackend, "Каталог/цены, расчёт чека", "internal")
Rel(apiGw, loyalty, "Операции лояльности", "internal")
Rel(apiGw, promo, "Промо-правила и снимки", "internal")
Rel(apiGw, fulfillment, "Заказы Click & Collect", "internal")

' --- Владение доменными БД (каждый сервис пишет только в свою БД) ---
Rel(mdm, mdmDb, "Чтение/запись мастер-данных", "SQL")
Rel(pricing, pricingDb, "Чтение/запись цен", "SQL")
Rel(posBackend, catalogDb, "Чтение сбытового каталога (read-model)", "SQL")
Rel(salesSvc, salesDb, "Чтение/запись операционных транзакций", "SQL")

' --- Наполнение catalog read-model (CQRS: события из мастер-доменов) ---
Rel(mdm, posBackend, "События изменения товаров/SKU", "event")
Rel(pricing, posBackend, "События изменения цен", "event")
Rel(promo, posBackend, "Снимок промо-правил", "event")

' --- Проведение продаж: единая логика записи для онлайн- и офлайн-пути ---
Rel(posBackend, salesSvc, "Проведение онлайн-продаж/возвратов", "internal")
Rel(syncSvc, salesSvc, "Проведение офлайн-продаж (тот же контракт, что онлайн)", "internal")

' --- Продажи -> финансы и лояльность (асинхронно, SAP вне критического пути) ---
Rel(salesSvc, sapCore, "Проводка фискальных/платёжных документов в финансы", "event, async")
Rel(syncSvc, loyalty, "Отложенное начисление/списание баллов (тот же API, что и онлайн-путь)", "API")

' --- Промо и фулфилмент читают мастер-домены через API (не общую БД) ---
Rel(promo, pricing, "Цены", "API")
Rel(promo, mdm, "Ассортимент/товары", "API")
Rel(fulfillment, mdm, "Товары/SKU", "API")
Rel(fulfillment, salesSvc, "Остатки/товародвижение (read-model)", "API")

' ==========================================================
'  СВЯЗИ: ОНБОРДИНГ НОВОЙ ТОЧКИ
' ==========================================================
Rel(fieldEng, legacyPos, "Снимает дамп номенклатуры", "CSV / XLS")
Rel(fieldEng, diPortal, "Загружает дамп", "Web UI")
Rel(diPortal, aiMap, "Запрос автомаппинга (нормализованные позиции)", "API")
Rel(aiMap, mdm, "Чтение эталонной базы SKU (штрихкоды, названия, атрибуты)", "API")
Rel(aiMap, diPortal, "Результаты маппинга + confidence-score", "API")
Rel(dataSteward, diPortal, "Подтверждает спорные позиции (<95%), правит позиции с ошибками QC", "Web UI")
Rel(diPortal, mdm, "Загрузка проверенной номенклатуры (товары/SKU)", "API")


note right of edgeGw
  HAL / Payment Gateway - способ решения «разного железа»:
  Cloud POS вызывает единый API и не знает о моделях устройств.
  Смена/добавление терминала происходит через новый адаптер в конфигурации,
  без переписывания и пересборки кассового ПО.
end note


SHOW_LEGEND()
@enduml
