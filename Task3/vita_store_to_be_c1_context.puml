@startuml VitaStore-TO-BE-C4-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title VitaStore - Целевая архитектура (TO-BE, C4 Context)

' ==========================================================
'  ЛЮДИ
' ==========================================================
Person(customer, "Покупатель", "Оплачивает наличными/картой, копит и списывает баллы лояльности")
Person(cashier, "Кассир", "Работает на тонком клиенте Cloud POS (планшет / Web POS)")
Person(dataSteward, "Товаровед / Data Integration", "Подтверждает только спорные позиции при онбординге новой точки")
Person(fieldEng, "Выездной ИТ-инженер (Team Store Ops)", "Ставит планшет и оборудование новой точки, загружает дамп номенклатуры, регистрирует оборудование")
Person(storeOps, "Инженер Team Store Ops (HQ)", "Ведёт реестр точек и оборудования, поддерживает каталог драйвер-адаптеров и конфигурацию")

' ==========================================================
'  ЦЕЛЕВАЯ СИСТЕМА
' ==========================================================
System(platform, "VitaStore Cloud Platform", "Единая облачная торговая платформа: Cloud POS (тонкий клиент), приём оплаты и фискализация через слой абстракции оборудования (HAL / Payment Gateway), офлайн-режим магазина, лояльность, промо, омниканальный фулфилмент, ERP и автоматический онбординг новых точек")

' ==========================================================
'  ВНЕШНИЕ СИСТЕМЫ И ОБОРУДОВАНИЕ
' ==========================================================
System_Ext(hardware, "Кассовое оборудование магазина", "Разнородные банковские терминалы (Сбербанк/ARCUS-2, Альфа, Ingenico, Verifone) и фискальные регистраторы (ККТ) - парк отличается от точки к точке")
System_Ext(acquirer, "Банки-эквайеры / платёжные системы", "Авторизация и расчёт по банковским картам (Сбербанк, Альфа-Банк и др.)")
System_Ext(ofd, "ОФД -> ФНС", "Оператор фискальных данных: приём фискальных документов, в т.ч. отложенно после офлайна, передача в налоговую")
System_Ext(legacyPos, "Легаси-касса купленного магазина", "Старый front-office и локальная база товаров - источник дампа номенклатуры при онбординге")

' ==========================================================
'  СВЯЗИ: ПРОДАЖА В МАГАЗИНЕ
' ==========================================================
Rel(customer, cashier, "Покупка, оплата, запрос по баллам", "лично")
Rel(cashier, platform, "Пробитие чеков, приём оплаты, лояльность", "тонкий клиент Cloud POS")
Rel(platform, hardware, "Единый API оплаты и фискализации через HAL (без вшитых драйверов)", "локально, планшет <-> устройство")
Rel(hardware, acquirer, "Авторизация карточного платежа", "защищённый канал банка")
Rel(platform, ofd, "Передача фискальных документов (в т.ч. отложенно)", "по каналу связи")

' ==========================================================
'  СВЯЗИ: ОНБОРДИНГ НОВОЙ ТОЧКИ (цель: 5 дней вместо 2 недель)
' ==========================================================
Rel(fieldEng, legacyPos, "Снимает дамп номенклатуры со старой кассы", "CSV / XLS")
Rel(fieldEng, platform, "Загружает дамп в портал онбординга, регистрирует оборудование точки", "HTTPS")
Rel(dataSteward, platform, "Подтверждает спорные позиции авто-маппинга", "веб-UI")
Rel(storeOps, platform, "Ведёт реестр оборудования и каталог драйвер-адаптеров", "веб-UI")

SHOW_LEGEND()
@enduml
