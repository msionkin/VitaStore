@startuml VitaStore-AS-IS-C4-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title VitaStore - Архитектура существующего решения (AS-IS, C4 Container)

' ==========================================================
'  ЛЮДИ
' ==========================================================
Person(customer, "Покупатель", "Оплачивает наличными/картой,\nпросит начислить/списать баллы лояльности")
Person(cashier, "Кассир", "Сотрудник магазина.\nПробивает чеки на «толстом» клиенте")
Person(fieldEng, "Выездной ИТ-инженер\n(Team Store Ops)", "Едет в купленный магазин,\nснимает дамп базы товаров")
Person(dataSteward, "Товаровед / Data Integration", "Вручную сопоставляет номенклатуру\n(VLOOKUP, ~500 позиций/час, 80% вручную)")

' ==========================================================
'  ЦЕНТРАЛЬНЫЙ ОФИС (HQ, ON-PREMISE)
' ==========================================================
System_Boundary(hq, "Центральный офис (HQ, On-Premise ЦОД)") {
    Container(sap, "SAP ERP", "on-premise", "Мастер-система: товары, цены, лояльность,\nфинансы, кадры. Эталонная база SKU")
    Container(promo, "Promo Engine", "on-premise", "Единый движок промоакций\n(конкурентное преимущество)")
    Container(fulfillment, "Smart Fulfillment", "on-premise", "Омниканальная логистика,\nClick & Collect (differentiator)")
    Container(mailbox, "Почтовый ящик\ndata-integration@vitastore.ru", "Email / SMTP", "Точка приёма CSV/XLS-дампов\nот выездных инженеров")
    Container(mapTool, "Маппинг", "Excel", "Ручное сведение номенклатуры\nкупленной сети магазинов с базой SAP ERP")
    Container(ftp, "FTP-сервер рассылки", "FTP", "В 02:00 рассылает XML-пакеты\nобновлённых прайс-листов по магазинам")
}

' ==========================================================
'  МАГАЗИН (STORE EDGE) — таких точек 500+
' ==========================================================
System_Boundary(store, "Магазин (Store Edge) — реплицируется на 500+ точек") {
    Container(pos, "POS App («толстый» клиент)", "Windows, C# (desktop)", "Монолит: UI кассы + бизнес-логика +\nвшитые драйверы фиск. регистраторов и\nбанковских терминалов")
    Container(backoffice, "Back-office / товарный учёт", "Windows desktop", "Приём товара от локальных поставщиков,\nинкассация, печать ценников,\nрасчёт премий продавцам (локально)")
    ContainerDb(localdb, "Local DB", "MS SQL Express / PostgreSQL", "Сервер в подсобке или ПК.\nПрайс-листы, справочники, чеки")
    Container(loyaltyBook, "Тетрадка с информацией по лояльности", "бумага", "Часть точек ведёт лояльность\nвручную «в тетрадке»")

    Container_Ext(printer, "Фискальный регистратор (ККТ)", "COM-port", "Печать фискальных чеков")
    Container_Ext(termIngenico, "Терминал Ingenico", "USB / собств. протокол", "")
    Container_Ext(termSber, "Терминал Сбер (ARCUS-2)", "USB / протокол ARCUS-2", "")
    Container_Ext(termOther, "Терминалы Verifone / Альфа", "USB / разные протоколы", "")
}

' ==========================================================
'  СВЯЗИ: РАБОТА КАССЫ
' ==========================================================
Rel(customer, cashier, "Покупка, оплата, запрос по баллам", "лично")
Rel(cashier, pos, "Пробитие чеков, работа с кассой", "UI")
Rel(pos, localdb, "Читает цены/справочники, пишет чеки", "Synchronous, LAN")
Rel(backoffice, localdb, "Учёт, ценники, премии, инкассация", "Synchronous, LAN")

Rel(pos, printer, "Прямое управление печатью", "COM-port driver")
Rel(pos, termIngenico, "Инициация оплаты", "вшитый USB-драйвер")
Rel(pos, termSber, "Инициация оплаты", "вшитый драйвер ARCUS-2")
Rel(pos, termOther, "Инициация оплаты", "вшитые USB-драйверы")

' ==========================================================
'  СВЯЗИ: ЛОЯЛЬНОСТЬ (единственный online-вызов)
' ==========================================================
Rel(pos, sap, "Начисление/списание баллов лояльности", "REST, real-time")

' ==========================================================
'  СВЯЗИ: НОЧНОЙ ПАКЕТНЫЙ ОБМЕН (реальность вместо real-time)
' ==========================================================
Rel(sap, promo, "Синхронизация акций/цен", "batch")
Rel(sap, ftp, "Формирует XML-пакет прайс-листов", "batch, 02:00")
Rel(ftp, localdb, "Рассылка обновлённых прайс-листов", "FTP, XML, ночью в 02:00")

' ==========================================================
'  СВЯЗИ: РУЧНОЙ ОНБОРДИНГ НОВОЙ ТОЧКИ (2-3 недели)
' ==========================================================
Rel(fieldEng, pos, "Снимает дамп базы товаров\nсо старой кассы", "CSV / XLS вручную")
Rel(fieldEng, mailbox, "Отправляет файл дампа", "Email")
Rel(dataSteward, mailbox, "Забирает файл дампа", "Email")
Rel(dataSteward, mapTool, "Ручной маппинг SKU,\n80% позиций вручную", "VLOOKUP")
Rel(mapTool, sap, "Загрузка сведённой номенклатуры", "импорт файла")

@enduml
